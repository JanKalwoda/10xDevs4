---
import "@/styles/global.css";
import AppTopBar from "@/components/AppTopBar.astro";
import TimerUiPreview from "@/components/timer/TimerUiPreview";

const isDevelopment = import.meta.env.DEV;
if (!isDevelopment) {
    Astro.response.status = 404;
}

const dark = Astro.url.searchParams.get("theme") === "dark";

const topBarFixtures = [
    { title: "Top bar: guest", user: null },
    { title: "Top bar: signed in", user: { email: "shooter@example.com" } },
    {
        title: "Top bar: long email (truncation)",
        user: { email: "a.very.long.email.address.for.truncation.checks@example-company-domain.example.com" },
    },
];
---

<!doctype html>
{isDevelopment && (
    <html lang="en" class:list={{ dark }}>
        <head>
            <meta charset="UTF-8" />
            <meta name="viewport" content="width=device-width" />
            <meta name="robots" content="noindex" />
            <title>Timer UI preview</title>
        </head>
        <body>
            <section aria-label="Top bar fixtures" class="top-bar-fixtures flex flex-col gap-4 p-4">
                {topBarFixtures.map(({ title, user }) => (
                    <div class="flex flex-col gap-2">
                        <h2 class="text-muted-foreground text-sm font-medium">{title}</h2>
                        <div class="border-border overflow-hidden rounded-lg border">
                            <AppTopBar user={user} fixture />
                        </div>
                    </div>
                ))}
            </section>
            <TimerUiPreview client:load />
        </body>
    </html>
)}

<style>
    /* The production bar is sticky; in the preview each fixture sits in normal flow. */
    .top-bar-fixtures :global(header) {
        position: static;
    }
</style>
