---
import Layout from "@/layouts/Layout.astro";
import { Card, CardContent, CardDescription, CardHeader } from "@/components/ui/card";
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";
import { isSafeNextPath, setEmailLinkPageSecurityHeaders } from "@/lib/email-auth";

setEmailLinkPageSecurityHeaders(Astro.response.headers);

const requestedNext = Astro.url.searchParams.get("next");
const next = isSafeNextPath(requestedNext) ? requestedNext : "/";
const signInHref = next === "/" ? "/auth/signin" : "/auth/signin?next=" + encodeURIComponent(next);
---

<Layout title="Check your email" enableTimerTheme showConfigWarnings={false} showTopBar={false}>
    <main class="flex min-h-screen items-center justify-center bg-background p-4 text-foreground">
        <Card className="w-full max-w-md gap-0 overflow-hidden py-0">
            <CardHeader className="gap-3 px-6 pt-8 sm:px-8">
                <p class="text-primary text-sm font-medium">Drill Me</p>
                <h1 class="text-2xl font-semibold tracking-tight">Check your email</h1>
                <CardDescription>If an account can use that email address, a sign-in link will arrive shortly. Open the link to continue.</CardDescription>
            </CardHeader>
            <CardContent className="flex flex-col gap-3 px-6 pb-8 sm:px-8">
                <a href={signInHref} class:list={[cn(buttonVariants({ variant: "default" }), "w-full")]}>
                    Use a different email address
                </a>
                <a href="/" class:list={[buttonVariants({ variant: "ghost" })]}>
                    Back to the timer
                </a>
            </CardContent>
        </Card>
    </main>
</Layout>
