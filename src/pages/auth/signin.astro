---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { Card, CardContent, CardDescription, CardHeader } from "@/components/ui/card";
import { isSafeNextPath } from "@/lib/email-auth";

const requestedNext = Astro.url.searchParams.get("next");
const next = isSafeNextPath(requestedNext) ? requestedNext : "/";
---

<Layout title="Enter your account" enableTimerTheme showConfigWarnings={false}>
    <main class="flex min-h-screen items-center justify-center bg-background p-4 text-foreground">
        <Card className="w-full max-w-md gap-0 overflow-hidden py-0">
            <CardHeader className="gap-3 px-6 pt-8 sm:px-8">
                <p class="text-primary text-sm font-medium">Drill Me</p>
                <h1 class="text-2xl font-semibold tracking-tight">Enter your account</h1>
                <CardDescription>Enter your email and we&apos;ll send a secure link to continue.</CardDescription>
            </CardHeader>
            <CardContent className="px-6 pb-8 sm:px-8">
                <SignInForm next={next} client:load />
            </CardContent>
        </Card>
    </main>
</Layout>
