---
import { Button, buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardHeader } from "@/components/ui/card";
import { TIMERS_HREF } from "@/lib/app-top-bar";
import { cn } from "@/lib/utils";

interface Props {
    email: string;
    // /dev/timer-ui shows several cards on one page, so only the real page uses an h1.
    headingLevel?: "h1" | "h2";
}

const { email, headingLevel = "h1" } = Astro.props;
const Heading = headingLevel;
---

<Card className="w-full max-w-md">
    <CardHeader>
        <Heading class="text-center text-3xl font-bold">Account</Heading>
    </CardHeader>
    <CardContent className="space-y-6">
        <p class="text-muted-foreground text-center text-sm">
            Signed in as <span class="text-foreground font-medium break-all">{email}</span>
        </p>
        <a href={TIMERS_HREF} class:list={[cn(buttonVariants({ size: "default" }), "w-full")]}>
            Timers
        </a>
        <form method="POST" action="/api/auth/signout">
            <Button type="submit" variant="outline" className="w-full">
                Sign out
            </Button>
        </form>
    </CardContent>
</Card>
