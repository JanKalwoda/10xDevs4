---
import AccountDetails from "@/components/AccountDetails.astro";
import Layout from "@/layouts/Layout.astro";
import { signInUrlForProtectedPath } from "@/lib/email-auth";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "private, no-store");

const { user } = Astro.locals;

// A top-level return crashes typescript-eslint on .astro files, so the redirect is set on the response.
if (!user) {
    Astro.response.status = 302;
    Astro.response.headers.set("Location", signInUrlForProtectedPath("/dashboard"));
}
---

{user && (
    <Layout title="Account" enableTimerTheme showConfigWarnings={false}>
        <main class="bg-background text-foreground flex flex-1 items-center justify-center px-4 py-8">
            <AccountDetails email={user.email ?? ""} />
        </main>
    </Layout>
)}
